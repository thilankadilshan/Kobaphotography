---
// Navbar.astro — Minimal cinematic navigation

// Extract the current path to handle active states dynamically
const pathname = Astro.url.pathname;
// Normalize pathname (removes trailing slash if it exists, except for the root '/')
const currentPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

// Helper function to check if a link is active
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<nav id="navbar" class="navbar-animate fixed top-0 left-0 w-full z-50 transition-all duration-700 ease-out py-6">
  <div class="relative z-50 max-w-7xl mx-auto px-6 md:px-12 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <img 
        src="/images/logo.png" 
        alt="KobaPhotography" 
        class="h-10 w-auto transition-transform duration-500 group-hover:scale-105"
        style="filter: brightness(0) invert(1);"
      />
      <span class="font-serif text-cream text-xl md:text-2xl font-light tracking-tight hidden md:block">
        Koba<span class="text-earth">Photography</span>
      </span>
    </a>

    <!-- Desktop Links (Updated to absolute root section IDs) -->
    <div class="hidden md:flex items-center gap-10">
      <a href="/" class={`nav-link text-xs tracking-[0.2em] uppercase transition-colors duration-300 relative group ${isActive('/') ? 'text-cream' : 'text-cream/70 hover:text-cream'}`}>
        Home
        <span class={`absolute -bottom-1 left-0 h-px bg-earth transition-all duration-300 ${isActive('/') ? 'w-full' : 'w-0 group-hover:w-full'}`}></span>
      </a>
      <a href="/#featured-stories" class="nav-link text-xs tracking-[0.2em] uppercase transition-colors duration-300 relative group text-cream/70 hover:text-cream">
        Stories
        <span class="absolute -bottom-1 left-0 h-px bg-earth transition-all duration-300 w-0 group-hover:w-full"></span>
      </a>
      <a href="/#about-teaser" class="nav-link text-xs tracking-[0.2em] uppercase transition-colors duration-300 relative group text-cream/70 hover:text-cream">
        About Me
        <span class="absolute -bottom-1 left-0 h-px bg-earth transition-all duration-300 w-0 group-hover:w-full"></span>
      </a>
      <a href="/#contact-section" class="nav-link text-xs tracking-[0.2em] uppercase transition-colors duration-300 relative group text-cream/70 hover:text-cream">
        Contact
        <span class="absolute -bottom-1 left-0 h-px bg-earth transition-all duration-300 w-0 group-hover:w-full"></span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button id="menu-btn" class="md:hidden text-cream p-2 relative z-50" aria-label="Open menu">
      <svg id="menu-icon" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg id="close-icon" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Backdrop Overlay -->
  <div id="mobile-backdrop" class="md:hidden fixed inset-0 z-30 opacity-0 pointer-events-none transition-opacity duration-500 ease-in-out" style="background-color: rgba(0,0,0,0.6); backdrop-filter: blur(4px);"></div>

  <!-- Mobile Menu Drawer (Slides from Right, 2/3 width) -->
  <div id="mobile-menu" class="md:hidden fixed top-0 right-0 h-dvh w-2/3 max-w-sm z-40 transform translate-x-full transition-transform duration-500 ease-out flex flex-col pt-32 pl-8 gap-8 shadow-2xl pointer-events-none border-l" style="background-color: #0A2947; border-color: rgba(243, 228, 201, 0.1);">
    <a href="/" class={`mobile-link font-serif text-3xl font-light tracking-wide transition-colors ${isActive('/') ? 'text-earth' : 'text-cream'}`}>Home</a>
    <a href="/#featured-stories" class="mobile-link font-serif text-3xl font-light tracking-wide transition-colors text-cream hover:text-earth">Stories</a>
    <a href="/#about-teaser" class="mobile-link font-serif text-3xl font-light tracking-wide transition-colors text-cream hover:text-earth">About Me</a>
    <a href="/#contact-section" class="mobile-link font-serif text-3xl font-light tracking-wide transition-colors text-cream hover:text-earth">Contact</a>
  </div>
</nav>

<script>
  (function() {
    // Navbar scroll behavior — null-safe
    const navbar = document.getElementById('navbar');
    if (!navbar) return;
    
    let lastScroll = 0;

    window.addEventListener('scroll', () => {
      const currentScroll = window.scrollY;
      
      if (currentScroll > 100) {
        navbar.style.backgroundColor = 'rgba(10, 41, 71, 0.9)'; // Navy with opacity
        navbar.style.backdropFilter = 'blur(12px)';
        navbar.classList.add('shadow-lg');
        navbar.classList.remove('py-6');
        navbar.classList.add('py-4');
      } else {
        navbar.style.backgroundColor = 'transparent';
        navbar.style.backdropFilter = 'none';
        navbar.classList.remove('shadow-lg');
        navbar.classList.remove('py-4');
        navbar.classList.add('py-6');
      }
      
      lastScroll = currentScroll;
    });

    // Mobile menu toggle logic
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileBackdrop = document.getElementById('mobile-backdrop');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    
    if (!menuBtn || !mobileMenu || !menuIcon || !closeIcon || !mobileBackdrop) return;
    
    let isOpen = false;

    const toggleMenu = () => {
      isOpen = !isOpen;
      if (isOpen) {
        // Slide drawer in
        mobileMenu.classList.remove('translate-x-full', 'pointer-events-none');
        mobileMenu.classList.add('translate-x-0', 'pointer-events-auto');
        
        // Fade backdrop in
        mobileBackdrop.classList.remove('opacity-0', 'pointer-events-none');
        mobileBackdrop.classList.add('opacity-100', 'pointer-events-auto');
        
        // Swap icons
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        
        // Prevent scrolling on body
        document.body.style.overflow = 'hidden';
      } else {
        // Slide drawer out
        mobileMenu.classList.add('translate-x-full', 'pointer-events-none');
        mobileMenu.classList.remove('translate-x-0', 'pointer-events-auto');
        
        // Fade backdrop out
        mobileBackdrop.classList.add('opacity-0', 'pointer-events-none');
        mobileBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
        
        // Swap icons
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        
        // Restore scrolling
        document.body.style.overflow = '';
      }
    };

    // Toggle on button click
    menuBtn.addEventListener('click', toggleMenu);
    
    // Close on backdrop click
    mobileBackdrop.addEventListener('click', () => {
      if (isOpen) toggleMenu();
    });

    // Close mobile menu on link click
    document.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => {
        if (isOpen) toggleMenu();
      });
    });
  })();
</script>

<style>
  .navbar-animate {
    opacity: 0;
    transform: translateY(-20px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  :global(.page-loaded) .navbar-animate {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.1s;
  }
  
  /* Adds smooth scrolling behavior when clicking anchor links */
  :global(html) {
    scroll-behavior: smooth;
  }
</style>