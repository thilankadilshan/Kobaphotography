---
// src/components/astro/AboutSection.astro
---

<section id="about-teaser" class="relative py-24 md:py-32 overflow-hidden" style="background-color: #0A2947;">
  <!-- Decorative cinematic gradient -->
  <div class="absolute top-0 right-0 w-full md:w-1/2 h-full opacity-5 pointer-events-none" style="background: radial-gradient(circle at center, #F3E4C9 0%, transparent 70%);"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-20 items-center">
      
      <!-- Image Column -->
      <div class="md:col-span-5 relative about-image-wrapper overflow-hidden rounded-sm" style="aspect-ratio: 4/5;">
        <!-- Moody overlay that fades out on scroll -->
        <div class="absolute inset-0 z-10 mix-blend-overlay pointer-events-none" style="background-color: rgba(10, 41, 71, 0.2);"></div>
        
        <!-- Profile Image -->
        <img 
          src="/images/profile.png" 
          alt="Uditha Ruwan - The Photographer" 
          class="about-image w-full h-full object-cover transform scale-110"
        />
        
        <!-- Elegant framing border -->
        <div class="absolute inset-4 border z-20 pointer-events-none" style="border-color: rgba(243, 228, 201, 0.15);"></div>
      </div>

      <!-- Text Column -->
      <div class="md:col-span-7 flex flex-col justify-center about-text-container">
        <span class="about-text-item font-sans text-xs md:text-sm tracking-[0.3em] uppercase mb-4" style="color: #8B5E3C;">
          The Photographer Behind The Stories
        </span>
        
        <h2 class="about-text-item font-serif text-5xl md:text-7xl font-light mb-8 leading-tight" style="color: #F3E4C9;">
          Uditha Ruwan
        </h2>
        
        <div class="about-text-item font-sans font-light text-base md:text-lg leading-relaxed space-y-6" style="color: #D3D4C0;">
          <p>
            Photography is more than just capturing light; it's about preserving the raw, unfiltered emotions that make a moment truly unforgettable. For me, every frame is a piece of a larger narrative waiting to be told.
          </p>
          <p>
            My approach blends cinematic composition with documentary-style authenticity. Whether it's the quiet anticipation before a wedding or the electric energy of a live event, I focus on the unspoken details that reveal the true essence of your story.
          </p>
        </div>

        <!-- CTA Link to full about page -->
        <div class="about-text-item mt-12 pt-8 border-t" style="border-color: rgba(211, 212, 192, 0.15);">
          <a href="#contact-section" class="group inline-flex items-center gap-4 text-sm tracking-widest uppercase transition-colors" style="color: #F3E4C9;">
            <span class="relative">
              Contact Me!
              <span class="absolute -bottom-2 left-0 w-0 h-px transition-all duration-500 group-hover:w-full" style="background-color: #8B5E3C;"></span>
            </span>
            <svg class="w-5 h-5 transform transition-transform duration-500 group-hover:translate-x-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // @ts-nocheck
  // The above comment disables VS Code's aggressive TypeScript checking for this vanilla JS block
  
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof window.gsap !== 'undefined' && typeof window.ScrollTrigger !== 'undefined') {
      const { gsap, ScrollTrigger } = window;
      
      gsap.registerPlugin(ScrollTrigger);

      // 1. Image Parallax & Brightness Reveal Effect
      gsap.fromTo('.about-image', 
        { 
          scale: 1.2,
          filter: 'brightness(0.6)'
        },
        {
          scale: 1,
          filter: 'brightness(1)',
          ease: 'power2.out',
          scrollTrigger: {
            trigger: '.about-image-wrapper',
            start: 'top 90%',
            end: 'top 30%',
            scrub: 1.5,
          }
        }
      );

      // 2. Staggered Text Reveal
      gsap.fromTo('.about-text-item',
        {
          y: 30,
          opacity: 0
        },
        {
          y: 0,
          opacity: 1,
          stagger: 0.15,
          duration: 1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '.about-text-container',
            start: 'top 85%',
            toggleActions: 'play none none reverse'
          }
        }
      );
    }
  });
</script>